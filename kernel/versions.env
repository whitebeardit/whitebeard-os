# Lockfile do Whitebeard OS. Mudar aqui = mudar em todos os hosts. Formato KEY=valor, lido por sh.
NODE_VERSION=24.22.2
NVM_VERSION=v0.40.8
UV_VERSION=0.13.5
CLAUDE_CODE_VERSION=2.1.314
HERMES_TAG=v2026.9.24
# Papel core: Paperclip (exige Node 24+)
PAPERCLIP_VERSION=2026.916.0
# Papel knowledge (Docker Compose): GBrain fixado por tag, imagens fixadas por versão
GBRAIN_REF=v0.60.37.0
BUN_IMAGE=oven/bun:1.4
PGVECTOR_IMAGE=pgvector/pgvector:pg17
OLLAMA_IMAGE=ollama/ollama:0.40.13
EMBED_MODEL=bge-m3
# Knowledge nativo (macOS, tudo-em-um): GBrain com PGLite (Postgres embutido) roda no Bun, e o Ollama nativo
# usa a GPU (Metal). Sem Docker. Binários oficiais fixados por versão e conferidos por sha256.
BUN_VERSION=1.4.4
BUN_URL_DARWIN_ARM64=https://github.com/oven-sh/bun/releases/download/bun-v1.4.4/bun-darwin-aarch64.zip
BUN_SHA256_DARWIN_ARM64=c240d7f0ccb90c263a849fcdb09b7ee62630d921348ed6aafda86b9d577bc510
OLLAMA_VERSION=0.40.13
OLLAMA_URL_DARWIN_ARM64=https://github.com/ollama/ollama/releases/download/v0.40.13/ollama-darwin.tgz
OLLAMA_SHA256_DARWIN_ARM64=bae29252232b9e1358cf5801a7d65a07442af18fb5467cb68c7fc3711f59c511
# FFmpeg: builds estáticos LGPL fixados por URL. O filtro whisper depende do build; o bootstrap informa.
FFMPEG_VERSION=9.0.2
FFMPEG_URL_LINUX_X86_64=https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-10-31-12-59/ffmpeg-n9.0.2-39-g7adfbe40dc-linux64-lgpl-9.0.tar.xz
FFMPEG_URL_DARWIN_ARM64=https://github.com/PattingHead/cutdone-ffmpeg/releases/download/ffmpeg-9.0.2-darwin-arm64/ffmpeg-9.0.2-darwin-arm64.tar.xz
# JARVIS Web: a interface do produto (app jarvis-desktop em modo web), clonada e construída no papel desktop
JARVIS_WEB_REPO=git@github.com:whitebeardit/jarvis-desktop.git
JARVIS_WEB_REF=main
JARVIS_WEB_PORT=8017
# Pacote pronto do JARVIS Web (bin/package-web.sh do jarvis-desktop), publicado em whitebeard-os-releases.
# Vazio: clone + build de JARVIS_WEB_REPO/REF (exige acesso ao repositório). JARVIS_WEB_FROM_GIT=1 força o clone.
JARVIS_WEB_VERSION=1.0.0-a8a8299
JARVIS_WEB_URL=https://github.com/whitebeardit/whitebeard-os-releases/releases/download/jarvis-web-1.0.0-a8a8299/jarvis-web-1.0.0-a8a8299.tar.gz
JARVIS_WEB_SHA256=54b6d98eecfdd09cae0b9ae3120f7a1923a1647b998ce74f72517fcf0eb4d74f
# FFmpeg com o filtro whisper: build próprio, publicado em whitebeard-os-releases (público, sem credencial).
# macOS: whisper na GPU (Metal) e avfoundation (câmera/microfone). Linux: estático, whisper em CPU
# (workflow ffmpeg-whisper.yml). Sem build próprio para a plataforma, fica o build público acima.
FFMPEG_WHISPER_URL_DARWIN_ARM64=https://github.com/whitebeardit/whitebeard-os-releases/releases/download/ffmpeg-whisper-metal-9.0.2-darwin-arm64/ffmpeg-whisper-metal-9.0.2-darwin-arm64.tar.xz
FFMPEG_WHISPER_SHA256_DARWIN_ARM64=28470a0ceaac57cadbcf711b0877caf5dc40373900ade5f71e2c7d25b8b07479
FFMPEG_WHISPER_URL_LINUX_X86_64=https://github.com/whitebeardit/whitebeard-os-releases/releases/download/ffmpeg-whisper-cpu-9.0-linux-x86_64/ffmpeg-whisper-cpu-9.0-linux-x86_64.tar.xz
FFMPEG_WHISPER_SHA256_LINUX_X86_64=26d564f3ba2a64fff0052a4e937bf776a66ba4e887d4ea5287bf1590aff9127e
